// ContourBot.exe: icon and version info (filled in by CMake from CMakeLists.txt)
#include <winver.h>

IDI_ICON1 ICON "@CMAKE_CURRENT_SOURCE_DIR@/resources/contourbot.ico"

VS_VERSION_INFO VERSIONINFO
FILEVERSION     @APP_VERSION_COMMAS@,0
PRODUCTVERSION  @APP_VERSION_COMMAS@,0
FILEFLAGSMASK   0x3fL
FILEFLAGS       0x0L
FILEOS          VOS_NT_WINDOWS32
FILETYPE        VFT_APP
FILESUBTYPE     VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "041904b0"
        BEGIN
            VALUE "CompanyName",      "@APP_AUTHOR@"
            VALUE "FileDescription",  "ContourBot - drawing bot for Paint"
            VALUE "FileVersion",      "@PROJECT_VERSION@"
            VALUE "InternalName",     "ContourBot"
            VALUE "LegalCopyright",   "GPL-3.0, @APP_AUTHOR@"
            VALUE "OriginalFilename", "ContourBot.exe"
            VALUE "ProductName",      "ContourBot"
            VALUE "ProductVersion",   "@PROJECT_VERSION@"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x419, 1200
    END
END
